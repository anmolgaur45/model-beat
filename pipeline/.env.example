# Copy this file to .env and fill in your values

DATABASE_HOST=<cloud-sql-public-ip>
DATABASE_PORT=5432
DATABASE_NAME=ainews
DATABASE_USER=ainews_app
DATABASE_PASSWORD=<password>

# Gemini on Vertex AI (impact scores, merge checks, summaries). Uses Google
# application default credentials: gcloud auth application-default login.
# Leave blank to skip those steps.
VERTEX_PROJECT=

# Artificial Analysis free API key (benchmarks). Leave blank to skip that sync.
AA_API_KEY=

# POST to this URL after each run to refresh the site's changed pages.
# Leave blank for local runs, or a local run will refresh the live site.
REVALIDATE_URL=
CRON_SECRET=<same value as frontend CRON_SECRET>
